{
  "name": "@spora-ai/components",
  "version": "0.1.1",
  "description": "Shared Vue 3 component primitives (Avatar, Icon, palettes, composables) for Spora frontends.",
  "keywords": [
    "spora",
    "vue",
    "components",
    "avatar",
    "icons"
  ],
  "homepage": "https://github.com/spora-ai/spora-components#readme",
  "bugs": {
    "url": "https://github.com/spora-ai/spora-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spora-ai/spora-components.git"
  },
  "license": "MIT",
  "author": "Fabian Graßl",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./avatar": {
      "types": "./dist/types/avatar/index.d.ts",
      "import": "./dist/avatar.js",
      "default": "./dist/avatar.js"
    },
    "./icons": {
      "types": "./dist/types/icons/index.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./composables": {
      "types": "./dist/types/composables/index.d.ts",
      "import": "./dist/composables.js",
      "default": "./dist/composables.js"
    },
    "./lib": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./types": {
      "types": "./dist/types/types/profilePicture.d.ts"
    },
    "./styles": "./dist/spora-components.css",
    "./styles.css": "./dist/spora-components.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --emitDeclarationOnly -p tsconfig.build.json && vite build",
    "lint": "eslint .",
    "lint:pkg": "publint --strict",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "happy-dom": "^20.8.9",
    "publint": "0.3.24",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.2",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
